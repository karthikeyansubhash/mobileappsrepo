graph TB
    subgraph "Test Execution Layer"
        A[test_suite_01_bell_notifications.py<br/>Validates bell icon visibility, clickability,<br/>and side panel behavior for authenticated<br/>and unauthenticated user states]
        B[test_suite_02_bell_notifications.py<br/>Validates notification panel UI layout,<br/>sign-in button display, close button<br/>functionality, and panel state transitions]
    end
    
    subgraph "Framework Infrastructure"
        C[Pytest Test Runner<br/>Orchestrates test discovery,<br/>execution, and reporting]
        D[Windows Automation Infrastructure<br/>Provides UI element interaction<br/>and application control capabilities]
        E[Authentication State Manager<br/>Controls user session states<br/>for test scenario partitioning]
    end
    
    subgraph "Target Application"
        F[HPX Desktop Application<br/>Global Header Navigation<br/>Bell Notification Icon]
        G[Notification Side Panel<br/>UI Layout & Controls<br/>Sign-in Enforcement]
    end
    
    subgraph "Knowledge Base Tracking"
        H[KB ID: 11589<br/>bell_notifications_batch1]
        I[KB ID: 11590<br/>bell_notifications_batch2]
        J[Code Documentation<br/>KB IDs: 11613, 11616, 11617]
    end
    
    A --> C
    B --> C
    A --> D
    B --> D
    A --> E
    B --> E
    
